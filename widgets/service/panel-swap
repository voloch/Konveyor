#!/usr/bin/env bash
# Swap the Konveyor panel widgets (Kontrol Panel launcher, Konveyor Taskbar) for KDE's Kickoff and Icon-only Task Manager, and back.
# `off` records which widgets it swapped; `on` puts back only those, so a widget the user removed stays removed.
# Plasma rewrites its config on exit, so the edits happen while plasmashell is stopped (--no-restart: the caller already stopped it).
set -euo pipefail

PLASMA_SERVICE="plasma-plasmashell.service"
LAUNCHER_PLUGIN="org.devl0rd.portal.launcher"
TASKBAR_PLUGIN="org.devl0rd.taskbar"

usage() {
    echo "usage: panel-swap off|on [--no-restart]" >&2
    exit 2
}

mode="${1-}"
restart=1
case "${2-}" in
    "") ;;
    --no-restart) restart=0 ;;
    *) usage ;;
esac
[[ $# -le 2 && ( $mode == off || $mode == on ) ]] || usage

service_dir="$(dirname "$(readlink -f "$0")")"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/konveyor"
appletsrc="$config_home/plasma-org.kde.plasma.desktop-appletsrc"
taskbarrc="$config_home/konveyor/taskbarrc"
state_file="$state_dir/panel-off"

mkdir -p "$state_dir"
# The installer holds this lock around its own stopped-Plasma window and sets PANEL_SWAP_LOCKED for the call it makes inside it.
if [[ ${PANEL_SWAP_LOCKED-} != 1 ]]; then
    exec 9>"$state_dir/panel-swap.lock"
    flock 9
fi

stopped=0

start_plasma() {
    if (( stopped )); then
        systemctl --user reset-failed "$PLASMA_SERVICE" 2>/dev/null || true
        systemctl --user start "$PLASMA_SERVICE"
    fi
}
trap start_plasma EXIT

# A hung plasmashell never finishes a normal stop: give it a few seconds, then SIGKILL it. The appletsrc is only edited
# after this returns, so nothing depends on plasmashell answering or saving on exit.
stop_plasma() {
    if (( restart )); then
        stopped=1
        if ! timeout "${PANEL_SWAP_STOP_GRACE:-5}" systemctl --user stop "$PLASMA_SERVICE"; then
            systemctl --user kill --signal=SIGKILL "$PLASMA_SERVICE" || true
            systemctl --user stop "$PLASMA_SERVICE"
        fi
    fi
}

has_plugin() {
    grep -qxF "plugin=$1" "$appletsrc" 2>/dev/null
}

recorded() {
    grep -qxF "$1" "$state_file"
}

present_widgets() {
    if has_plugin "$LAUNCHER_PLUGIN"; then echo launcher; fi
    if has_plugin "$TASKBAR_PLUGIN"; then echo taskbar; fi
}

swap_off() {
    local swapped record
    [[ -n "$(present_widgets)" ]] || return 0
    stop_plasma
    # plasmashell flushes the appletsrc when it exits, so only now do we know which widgets are really there
    swapped="$(present_widgets)"
    [[ -n $swapped ]] || return 0
    # keep what an earlier off recorded: a widget that is native again now must still come back on
    record="$({ printf '%s\n' "$swapped"; cat "$state_file" 2>/dev/null || true; } | sort -u)"
    printf '%s\n' "$record" >"$state_file"
    python3 "$service_dir/panel-taskbar" settings "$appletsrc" "$taskbarrc"
    if recorded taskbar; then python3 "$service_dir/panel-taskbar" uninstall "$appletsrc" "$taskbarrc"; fi
    if recorded launcher; then python3 "$service_dir/panel-launcher" uninstall "$appletsrc"; fi
}

# `panel-taskbar settings` keeps the pins stored for the taskbar over the ones in the applet. While Konveyor was off the native task
# manager owns the pins, so when it has any, forget the stored ones and let the user's changes win.
prefer_native_pins() {
    python3 - "$service_dir" "$appletsrc" "$taskbarrc" <<'PY'
import sys

sys.path.insert(0, sys.argv[1])
from appletsrc import panel_applets, read_groups, value, write_groups

appletsrc, taskbarrc = sys.argv[2:]
try:
    groups = read_groups(appletsrc)
    stored = read_groups(taskbarrc)
except FileNotFoundError:
    sys.exit(0)
settings = {header: lines for header, lines in groups if header}
managers = [header for _, header, lines in panel_applets(groups) if value(lines, "plugin") in ("org.kde.plasma.icontasks", "org.kde.plasma.taskmanager")]
if any(value(settings.get(header + "[Configuration][General]", []), "launchers") is not None for header in managers):
    write_groups(taskbarrc, [(header, [line for line in lines if line.partition("=")[0] != "launchers"] if header == "[General]" else lines)
                             for header, lines in stored])
PY
}

swap_on() {
    [[ -e $state_file ]] || return 0
    stop_plasma
    if recorded launcher; then python3 "$service_dir/panel-launcher" install "$appletsrc"; fi
    if recorded taskbar; then
        prefer_native_pins
        python3 "$service_dir/panel-taskbar" install "$appletsrc"
    fi
    python3 "$service_dir/panel-taskbar" settings "$appletsrc" "$taskbarrc"
    rm -f "$state_file"
}

"swap_$mode"
